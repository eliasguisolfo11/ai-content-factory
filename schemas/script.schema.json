{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Short factual video script",
  "type": "object",
  "required": ["title", "hook", "target_duration", "format", "scenes", "source_ids"],
  "properties": {
    "title": {"type": "string", "minLength": 5, "maxLength": 100},
    "hook": {"type": "string", "minLength": 10, "maxLength": 240},
    "target_duration": {"type": "integer", "minimum": 45, "maximum": 120},
    "format": {"type": "string"},
    "scenes": {
      "type": "array", "minItems": 5, "maxItems": 20,
      "items": {"type": "object", "required": ["start", "end", "narration", "visual", "caption", "source_ids"], "properties": {
        "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0},
        "narration": {"type": "string", "minLength": 8}, "visual": {"type": "string", "minLength": 8},
        "caption": {"type": "string", "maxLength": 50}, "source_ids": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false}
    },
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "editorial_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
